# Database
DATABASE_URL="file:./dev.db"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production-please-32-chars-min"

# Optional: Web Push (VAPID). Generate with:
#   npx web-push generate-vapid-keys
# If left blank, push notifications are disabled (in-app reminders still work).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT="mailto:admin@example.com"

# Public mirror of VAPID public key (must be exposed to the browser)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
